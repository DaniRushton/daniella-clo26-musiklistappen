<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADO.NET-leverantören för SQLite -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lägg din databasfil som MusikApp/musik.db, så följer den med när du kör från Visual Studio också. -->
    <None Update="musik.db" CopyToOutputDirectory="PreserveNewest" Condition="Exists('musik.db')" />
  </ItemGroup>

</Project>
